{
  "name": "obsidian-auto-periodic-notes",
  "version": "1.2.3",
  "description": "Creates new periodic notes automatically in the background and allows these to be pinned in your open tabs, requires the Periodic Notes plugin.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest",
    "coverage": "jest --coverage",
    "test-ci": "jest --ci --reporters=default --reporters=jest-junit --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "husky",
    "version": "node version-bump.mjs"
  },
  "author": "Jamie Hurst <jamie@jamiehurst.co.uk>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamiefdhurst/obsidian-auto-periodic-notes/issues"
  },
  "homepage": "https://github.com/jamiefdhurst/obsidian-auto-periodic-notes#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "moment": "^2.30.1",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "obsidian-periodic-notes-provider": "^2.0.0"
  },
  "nano-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
